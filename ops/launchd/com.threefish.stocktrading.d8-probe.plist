<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- D8 港股时戳重探采样槽：周一至五 09:36 与 13:06 两对照时点（定谳后 bootout）。 -->
<!-- 安装：sed 替换 __REPO_PATH__ 后 bootstrap；流程见 docs/ops/trading-day-verify.md。 -->
<!-- 注释内不使用连续连字符（plist XML 兼容纪律，沿第四槽先例）。 -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.threefish.stocktrading.d8-probe</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>__REPO_PATH__/ops/d8_probe.py</string>
	</array>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Weekday</key>
			<integer>1</integer>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>36</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>1</integer>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>6</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>2</integer>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>36</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>2</integer>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>6</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>3</integer>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>36</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>3</integer>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>6</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>4</integer>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>36</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>4</integer>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>6</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>5</integer>
			<key>Hour</key>
			<integer>9</integer>
			<key>Minute</key>
			<integer>36</integer>
		</dict>
		<dict>
			<key>Weekday</key>
			<integer>5</integer>
			<key>Hour</key>
			<integer>13</integer>
			<key>Minute</key>
			<integer>6</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>__HOME__/.vibe-stock/agent/logs/d8-probe.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.vibe-stock/agent/logs/d8-probe.log</string>
</dict>
</plist>
